{
  "manifest_version": 3,
  "name": "Brave-EndShift",
  "version": "1.1.1",
  "author": "Anti-furry-cloud",
  "description": "Choose where YouTube videos end. Skip unwanted outros on every loop.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Brave-EndShift",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
